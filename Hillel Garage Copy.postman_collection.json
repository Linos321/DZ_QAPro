		{
			"name": "Edit profile",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let newFirstName = pm.variables.replaceIn(\"{{$randomFirstName}}\");\r",
							"let newLastName = pm.variables.replaceIn(\"{{$randomLastName}}\");\r",
							"let newCountry = pm.variables.replaceIn(\"{{$randomCountry}}\");\r",
							"let date = new Date();\r",
							"date.setFullYear(date.getFullYear() - Math.floor(Math.random() * 20 + 1));\r",
							"let newDateOfBirth = date.toISOString().split('T')[0];\r",
							"\r",
							"pm.collectionVariables.set(\"edit_profile_name\", newFirstName);\r",
							"pm.collectionVariables.set(\"edit_profile_lastName\", newLastName);\r",
							"pm.collectionVariables.set(\"edit_profile_country\", newCountry);\r",
							"pm.collectionVariables.set(\"edit_profile_dateBirth\", newDateOfBirth);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Статус 200 или 201\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"const resp = pm.response.json();",
							"pm.test(\"Имя совпадает\", function () {",
							"    pm.expect(resp).to.satisfy(r => r.name || (r.data && r.data.name));",
