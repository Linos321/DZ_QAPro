{
	"info": {
		"_postman_id": "cdb974ed-0142-4ffb-90ce-cd77da11d824",
		"name": "Book ISBN Numbers — SOAP Homework",
		"description": "ДЗ: 2 SOAP-запроса к сервису валидации ISBN (IsValidISBN13, IsValidISBN10) + по 10 тестов (исправленные проверки Response/Result).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "44690699"
	},
	"item": [
		{
			"name": "Is Valid ISBN13 Number",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус код 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Content-Type содержит xml\", function () {",
							"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"xml\");",
							"});",
							"",
							"pm.test(\"Есть SOAP Envelope\", function () {",
							"  const b = pm.response.text();",
							"  pm.expect(b.includes(\"<soap:Envelope\") || b.includes(\"<soap12:Envelope\")).to.be.true;",
							"});",
							"",
							"pm.test(\"Есть тег ответа метода\", function () {",
							"  pm.expect(pm.response.text()).to.include(\"IsValidISBN13Response\");",
							"});",
							"",
							"pm.test(\"Результат метода корректный\", function () {",
							"  pm.expect(pm.response.text()).to.include(\"IsValidISBN13Result>true\");",
							"});",
							"",
							"pm.test(\"Тело ответа не пустое\", function () {",
							"  pm.expect(pm.response.text().length).to.be.above(0);",
							"});",
							"",
							"pm.test(\"Ответ не HTML ошибка\", function () {",
							"  pm.expect(pm.response.text().startsWith(\"<!DOCTYPE html>\")).to.be.false;",
							"});",
							"",
							"pm.test(\"XML разбирается в JSON\", function () {",
							"  const json = xml2Json(pm.response.text());",
							"  pm.expect(json).to.be.an(\"object\");",
							"});",
							"",
							"pm.test(\"Время ответа < 3000 мс\", function () {",
							"  pm.expect(pm.response.responseTime).to.be.below(3000);",
							"});",
							"",
							"pm.test(\"Есть заголовок Date\", function () {",
							"  pm.response.to.have.header(\"Date\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"packages": {},
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>9780134685991</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
				},
				"url": {
					"raw": "https://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "https",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				}
			},
			"response": []
		},
