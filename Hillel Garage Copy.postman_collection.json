		{
			"name": "Sign up",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"function safeJson(){",
							"  try { return pm.response.json(); } catch(e){ return {}; }",
							"}",
							"",
							"const code = pm.response.code;",
							"pm.test(\"Sign up: статус 200/201/400/409\", function () {",
							"    pm.expect(code).to.be.oneOf([200,201,400,409]);",
							"});",
							"",
							"if (code === 200 || code === 201) {",
							"    pm.test(\"Sign up success: ответ не пустой\", function () {",
							"        const d = safeJson();",
							"        pm.expect(Object.keys(d).length).to.be.greaterThan(0);",
							"    });",
							"}",
							"pm.test(\"Email в ответе совпадает с email из файла\", function () {",
							"    const responseData = pm.response.json();",
							"    pm.expect(responseData.email).to.eql(pm.environment.get('random_mail'));",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Берём email из CSV (iteration data) и добавляем уникальный тег",
							"let csvEmail = pm.iterationData.get(\"random_mail\") || pm.variables.get(\"random_mail\");",
							"let finalEmail;",
							"if (csvEmail && csvEmail.includes(\"@\")) {",
							"  const parts = csvEmail.split(\"@\");",
							"  const local = parts[0];",
							"  const domain = parts.slice(1).join(\"@\");",
							"  const uniq = Date.now().toString().slice(-6) + Math.floor(Math.random()*1000);",
							"  finalEmail = `${local}+${uniq}@${domain}`;",
							"} else {",
							"  finalEmail = pm.variables.replaceIn(\"{{$randomEmail}}\");",
							"}",
							"pm.variables.set(\"_email\", finalEmail);",
							"pm.collectionVariables.set(\"created_email\", finalEmail);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"{{$randomFirstName}}\",\n  \"lastName\": \"{{$randomLastName}}\",\n  \"email\": \"{{_email}}\",\n  \"password\": \"{{password}}\",\n  \"repeatPassword\": \"{{password}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{MyURL}}/auth/signup",
					"host": [
						"{{MyURL}}"
					],
					"path": [
						"auth",
						"signup"
					]
				},
				"description": "Generated from cURL: curl -X 'POST' \\\r\n  'https://qauto2.forstudy.space/api/auth/signup' \\\r\n  -H 'accept: application/json' \\\r\n  -H 'Content-Type: application/json' \\\r\n  -d '{\r\n  \"name\": \"John\",\r\n  \"lastName\": \"Dou\",\r\n  \"email\": \"test@test.com\",\r\n  \"password\": \"Qwerty12345\",\r\n  \"repeatPassword\": \"Qwerty12345\"\r\n}'"
			},
			"response": []
